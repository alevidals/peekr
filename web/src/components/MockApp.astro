---
import appIcon from "../assets/app-icon.png";

interface Row {
  title: string;
  author: string;
  initial: string;
  avatar: string;
  number: string;
  branch: string;
  destination: string;
  ci: "success" | "pending" | "failed";
  approvals: number;
  comments: number;
  time: string;
}

interface Group {
  source: "GitHub" | "Bitbucket";
  repo: string;
  rows: Row[];
}

const groups: Group[] = [
  {
    source: "GitHub",
    repo: "platform/console",
    rows: [
      {
        title: "Add review filters to the inbox",
        author: "Maya Chen",
        initial: "M",
        avatar: "#d7c7a8",
        number: "#128",
        branch: "feat/filters",
        destination: "main",
        ci: "success",
        approvals: 2,
        comments: 6,
        time: "19h",
      },
      {
        title: "Fix token refresh on reconnect",
        author: "Jon Bell",
        initial: "J",
        avatar: "#c7d4d7",
        number: "#127",
        branch: "fix/token-refresh",
        destination: "main",
        ci: "pending",
        approvals: 1,
        comments: 1,
        time: "19h",
      },
      {
        title: "Cache review-request lookups",
        author: "Lena Ortiz",
        initial: "L",
        avatar: "#d8c7d7",
        number: "#124",
        branch: "perf/cache",
        destination: "main",
        ci: "success",
        approvals: 2,
        comments: 3,
        time: "20h",
      },
    ],
  },
  {
    source: "Bitbucket",
    repo: "billing/service",
    rows: [
      {
        title: "Bump tracing to 0.1.44",
        author: "Priya N.",
        initial: "P",
        avatar: "#d7d0b8",
        number: "#52",
        branch: "chore/tracing",
        destination: "main",
        ci: "failed",
        approvals: 0,
        comments: 2,
        time: "1d",
      },
      {
        title: "Split billing webhooks by region",
        author: "Tomás R.",
        initial: "T",
        avatar: "#c7d7c9",
        number: "#49",
        branch: "feat/webhooks",
        destination: "develop",
        ci: "pending",
        approvals: 1,
        comments: 0,
        time: "1d",
      },
      {
        title: "Drop the legacy export job",
        author: "Maya Chen",
        initial: "M",
        avatar: "#d7c7a8",
        number: "#48",
        branch: "chore/export",
        destination: "main",
        ci: "success",
        approvals: 2,
        comments: 4,
        time: "1d",
      },
    ],
  },
];

const total = groups.reduce((sum, group) => sum + group.rows.length, 0);
---

<div class="hero-stage">
  <div
    class="app-mock"
    role="img"
    aria-label="Mock of the peekr tray popover listing review requests from GitHub and Bitbucket"
  >
    <div class="app-head" aria-hidden="true">
      <div class="app-title">
        <img src={appIcon.src} width="18" height="18" alt="" />
        <span>peekr</span>
      </div>
      <div class="app-tools">
        <span class="app-tool app-tool--search" />
        <span class="app-tool app-tool--gear" />
      </div>
    </div>

    <div class="app-tabbar" aria-hidden="true">
      <span class="app-tab app-tab--active">To review <b>{total}</b></span>
      <span class="app-tab">My PRs <b>1/3</b></span>
    </div>

    <div class="app-list" aria-hidden="true">
      {
        groups.map((group) => (
          <div class="app-group">
            <div class="app-group-head">
              {group.source === "GitHub" ? (
                <svg class="app-provider" viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                  <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.79.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
                </svg>
              ) : (
                <svg class="app-provider" viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                  <path d="M2.7 3.5a.7.7 0 0 0-.7.8l2.9 17.6c.1.4.4.7.8.7h13.8c.3 0 .6-.2.6-.6L23 4.3a.7.7 0 0 0-.7-.8H2.7zm12.5 12.3H9L7.7 9h8.7l-1.2 6.8z" />
                </svg>
              )}
              <span class="app-repo">{group.repo}</span>
              <span class="app-source">{group.source}</span>
              <span class="app-count">{group.rows.length}</span>
            </div>

            {group.rows.map((row) => (
              <div class="app-row">
                <span class="app-avatar" style={`--avatar-bg:${row.avatar}`}>
                  {row.initial}
                </span>
                <div class="app-body">
                  <div class="app-top">
                    <div class="app-heading">
                      <span class="pr-title">{row.title}</span>
                      <span class="pr-number">{row.number}</span>
                    </div>
                    <span class="pr-author">{row.author}</span>
                  </div>
                  <div class="app-sub">
                    <span class="app-branch">
                      <svg
                        viewBox="0 0 24 24"
                        width="11"
                        height="11"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="6" cy="6" r="2" />
                        <circle cx="6" cy="18" r="2" />
                        <circle cx="18" cy="8" r="2" />
                        <path d="M6 8v8M18 10c0 4-6 3-12 6" />
                      </svg>
                      <span class="app-branch-text">
                        {row.branch} to {row.destination}
                      </span>
                    </span>
                    <span class="app-meta">
                      <span class={`ci ci--${row.ci}`}>
                        <svg
                          viewBox="0 0 24 24"
                          width="9"
                          height="9"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path
                            d={
                              row.ci === "success"
                                ? "M5 12l5 5L20 7"
                                : row.ci === "failed"
                                  ? "M6 6l12 12M18 6L6 18"
                                  : "M20 11a8.1 8.1 0 0 0-15.5-2m-.5-4v4h4M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"
                            }
                          />
                        </svg>
                      </span>
                      {row.approvals > 0 && (
                        <span class="pr-approvals">
                          <svg
                            viewBox="0 0 24 24"
                            width="11"
                            height="11"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M5 12l5 5L20 7" />
                          </svg>
                          {row.approvals}
                        </span>
                      )}
                      {row.comments > 0 && (
                        <span class="pr-comments">
                          <svg
                            viewBox="0 0 24 24"
                            width="11"
                            height="11"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M8 9h8" />
                            <path d="M8 13h6" />
                            <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-5l-5 3v-3h-2a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h12z" />
                          </svg>
                          {row.comments}
                        </span>
                      )}
                      <span class="pr-time">{row.time}</span>
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <div class="app-foot" aria-hidden="true">
      <span>Updated now</span>
      <span>{total} waiting</span>
    </div>
  </div>

  <div class="float-card float-card--notify" aria-hidden="true">
    <span class="float-meta">peekr, just now</span>
    <strong>Ready to merge</strong>
    <span>platform/console #128</span>
  </div>
</div>
