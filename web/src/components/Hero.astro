---
import { REPO_URL } from "../lib/releases";

interface Props {
  version: string;
}

const { version } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section class="hero" id="product">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        Your review queue,<br />
        not your inbox.
      </h1>

      <p class="hero-lead">
        Every review request from Bitbucket and GitHub, in one quiet place.
      </p>

      <div class="hero-actions">
        <a class="button button--ink" href="#download">Download peekr</a>
        <a class="button button--ghost" href={REPO_URL}>View source</a>
      </div>

      <ul class="hero-facts">
        <li class="hero-version">v{version}</li>
        <li>macOS</li>
        <li>Windows</li>
        <li>Linux</li>
        <li>MIT</li>
      </ul>
    </div>

    <div class="hero-stage">
      <div class="hero-shot-wrap">
        <img
          class="hero-shot"
          src={`${base}product/theme-system.png?v=2`}
          width="380"
          height="627"
          alt="The peekr popover listing review requests from GitHub and Bitbucket, grouped by repository with checks, approvals and comments."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
