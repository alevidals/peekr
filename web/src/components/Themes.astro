---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const themes = [
  { name: "System", desc: "Follows the system", file: "theme-system-card.png" },
  { name: "Dark", desc: "Peekr dark", file: "theme-dark.png" },
  { name: "Light", desc: "Peekr light", file: "theme-light.png" },
  { name: "One Dark", desc: "Atom’s classic", file: "theme-one-dark.png" },
  { name: "Gruvbox Dark", desc: "Warm and retro", file: "theme-gruvbox-dark.png" },
  { name: "Gruvbox Light", desc: "Warm paper", file: "theme-gruvbox-light.png" },
  { name: "Nord", desc: "Arctic blues", file: "theme-nord.png" },
  { name: "Dracula", desc: "Vivid purple", file: "theme-dracula.png" },
  { name: "Solarized Light", desc: "Precision light", file: "theme-solarized-light.png" },
  { name: "Tokyo Night", desc: "Neon city", file: "theme-tokyo-night.png" },
  { name: "Catppuccin Mocha", desc: "Soft pastels", file: "theme-catppuccin-mocha.png" },
];
---

<section class="section themes" id="themes">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <h2>Dress for<br />the room.</h2>
      </div>
      <div class="section-side">
        <p class="section-lead">
          System, light and dark, plus the eight named palettes you already stare at all day.
          Density and text size follow the same config.
        </p>
        <span class="stamp">11 looks, one popover</span>
      </div>
    </div>

    <div class="theme-grid theme-grid--shots">
      {
        themes.map((theme) => (
          <figure class="theme-shot">
            <div class="theme-shot-frame">
              <img
                src={`${base}product/${theme.file}?v=1`}
                width="380"
                height="503"
                alt={`The peekr popover in the ${theme.name} theme`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span class="theme-shot-name">{theme.name}</span>
              <span class="theme-shot-desc">{theme.desc}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
