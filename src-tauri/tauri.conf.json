{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "peekr",
  "version": "0.1.0",
  "identifier": "com.alevidals.peekr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "peekr",
        "width": 380,
        "height": 500,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "peekr — Settings",
        "width": 480,
        "height": 640,
        "visible": false,
        "decorations": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
